Sub AktualizujWszystkieZakladki_Mac_OchronaWagi()
    Dim wsZmiany As Worksheet, wsDocelowy As Worksheet
    Dim colWiersze As Collection, colKolumny As Collection
    Dim arrZmiany As Variant, arrDane As Variant
    Dim id As String, param As String, wartosc As Variant
    Dim i As Long, j As Long, col As Long, row As Long
    Dim lastRowZmiany As Long, lastColZmiany As Long
    Dim lastRowDane As Long, lastColDane As Long
    Dim k As Long
    
    ' 1. Pobranie danych ze źródła (Sheet1)
    Set wsZmiany = ThisWorkbook.Sheets("Sheet1")
    lastRowZmiany = wsZmiany.Cells(wsZmiany.Rows.Count, 1).End(xlUp).Row
    lastColZmiany = wsZmiany.Cells(1, wsZmiany.Columns.Count).End(xlToLeft).Column
    
    ' Wczytanie Sheet1 do pamięci (tylko do odczytu)
    arrZmiany = wsZmiany.Range(wsZmiany.Cells(1, 1), wsZmiany.Cells(lastRowZmiany, lastColZmiany)).Value
    
    ' 2. Pętla przez wszystkie arkusze
    For k = 1 To ThisWorkbook.Sheets.Count
        Set wsDocelowy = ThisWorkbook.Sheets(k)
        
        If wsDocelowy.Name <> "Sheet1" Then
            lastRowDane = wsDocelowy.Cells(wsDocelowy.Rows.Count, 1).End(xlUp).Row
            lastColDane = wsDocelowy.Cells(2, wsDocelowy.Columns.Count).End(xlToLeft).Column
            
            If lastRowDane >= 3 And lastColDane >= 1 Then
                ' Wczytujemy dane arkusza wyłącznie w celu stworzenia mapy wyszukiwań
                arrDane = wsDocelowy.Range(wsDocelowy.Cells(1, 1), wsDocelowy.Cells(lastRowDane, lastColDane)).Value
                
                Set colWiersze = New Collection
                Set colKolumny = New Collection
                
                ' Mapowanie wierszy po ID
                On Error Resume Next 
                For i = 3 To lastRowDane
                    id = CStr(arrDane(i, 1))
                    If id <> "" Then colWiersze.Add i, id
                Next i
                
                ' Mapowanie kolumn z TARCZĄ na kolumnę Wagi
                For j = 1 To lastColDane
                    param = Trim(CStr(arrDane(2, j)))
                    
                    ' ZABEZPIECZENIE: Ignorujemy pustki oraz chronioną kolumnę
                    If param <> "" And LCase(param) <> LCase("Waga produktu z opakowaniem jednostkowym") Then
                        colKolumny.Add j, param
                    End If
                Next j
                On Error GoTo 0
                
                ' Bezpieczna, punktowa aktualizacja danych
                For i = 2 To lastRowZmiany
                    id = CStr(arrZmiany(i, 1))
                    row = 0
                    
                    On Error Resume Next
                    row = colWiersze(id)
                    On Error GoTo 0
                    
                    If row > 0 Then
                        For j = 2 To lastColZmiany Step 2
                            ' Ignorowanie pustych komórek w Sheet1
                            If Not IsEmpty(arrZmiany(i, j)) And Not IsError(arrZmiany(i, j)) Then
                                param = Trim(CStr(arrZmiany(i, j)))
                                
                                If param <> "" Then
                                    wartosc = arrZmiany(i, j + 1)
                                    col = 0
                                    
                                    On Error Resume Next
                                    col = colKolumny(param)
                                    On Error GoTo 0
                                    
                                    ' Aktualizacja BEZPOŚREDNIO w komórce docelowej (chroni format!)
                                    If col > 0 Then
                                        wsDocelowy.Cells(row, col).Value = wartosc
                                    End If
                                End If
                            End If
                        Next j
                    End If
                Next i
            End If
        End If
    Next k
    
    MsgBox "Wszystkie zakładki zaktualizowane! Kolumna 'Waga...' i formaty pliku pozostały nienaruszone. 🛡️⚡️", vbInformation, "Sukces"
End Sub
